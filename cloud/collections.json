{
  "collections": [
    {
      "name": "mc_shared_records",
      "purpose": "家庭共享数字记录（体重/血压/胎动/共享短备注），文档 ID：familyId:type:dateKey",
      "fields": {
        "_id": "familyId:type:dateKey",
        "familyId": "固定家庭标识（数据分区，非授权依据）",
        "type": "记录类型（B1：daily）",
        "dateKey": "YYYY-MM-DD",
        "payload": "白名单字段：weightKg/systolic/diastolic/fetalCount/note",
        "revision": "乐观并发版本号，每次成功写入 +1",
        "updatedBy": "服务端生成的成员 ID（mama/papa）",
        "updatedAt": "毫秒时间戳",
        "lastOperationId": "最后一次写入的操作 ID（审计）"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "familyId",
              "direction": 1
            },
            {
              "name": "dateKey",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_private_notes",
      "purpose": "私人笔记，按成员隔离；文档 ID 内嵌 ownerId，另一成员无法命中",
      "fields": {
        "_id": "familyId:memberId:dateKey",
        "familyId": "数据分区",
        "ownerId": "服务端生成的成员 ID（仅本人可读写）",
        "dateKey": "YYYY-MM-DD",
        "content": "私人正文（≤2000 字）",
        "revision": "乐观并发版本号",
        "updatedBy": "= ownerId",
        "updatedAt": "毫秒时间戳",
        "lastOperationId": "操作 ID"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "ownerId",
              "direction": 1
            },
            {
              "name": "dateKey",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_operations",
      "purpose": "操作去重（幂等）；文档 ID：memberId:operationId。存请求摘要与首次结果快照",
      "fields": {
        "_id": "memberId:operationId",
        "memberId": "操作者",
        "operationId": "客户端生成的稳定操作 ID",
        "kind": "shared-record-upsert | private-note-upsert",
        "requestHash": "业务参数确定性摘要；同 ID 不同摘要 → 拒绝",
        "resultSnapshot": "首次成功结果（幂等重放用）",
        "createdAt": "毫秒时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "memberId",
              "direction": 1
            },
            {
              "name": "createdAt",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_pregnancy",
      "purpose": "家庭孕期档案单例（B2a）；文档 ID：familyId:pregnancy",
      "fields": {
        "_id": "familyId:pregnancy",
        "familyId": "数据分区（非授权依据）",
        "type": "pregnancy",
        "fields": "白名单字段：lmpDate/dueDate/nickname/babyNickname/hospital/doctor/hospitalPhone/preWeightKg/heightCm",
        "schemaVersion": "1（存量不支持版本全路径拒绝）",
        "revision": "乐观并发版本号",
        "updatedBy": "服务端生成成员 ID",
        "updatedAt": "毫秒时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "familyId",
              "direction": 1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_health_daily",
      "purpose": "共享健康数字（B2a，按日一条）；文档 ID：familyId:dateKey",
      "fields": {
        "_id": "familyId:dateKey",
        "familyId": "数据分区",
        "type": "daily",
        "dateKey": "YYYY-MM-DD（分页稳定排序键，游标）",
        "fields": "白名单字段：weightKg/systolic/diastolic/fetalCount/sharedNote",
        "deleted": "墓碑标记（删除后阻止迟到编辑复活）",
        "schemaVersion": "1",
        "revision": "乐观并发版本号",
        "updatedBy": "服务端生成成员 ID",
        "updatedAt": "毫秒时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "familyId",
              "direction": 1
            },
            {
              "name": "dateKey",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_moods",
      "purpose": "私人心情/症状/备注/计划（B2a，仅本人）；文档 ID：familyId:memberId:dateKey",
      "fields": {
        "_id": "familyId:memberId:dateKey",
        "familyId": "数据分区",
        "ownerId": "服务端生成成员 ID（跨成员隔离）",
        "type": "mood",
        "dateKey": "YYYY-MM-DD（分页稳定排序键，游标）",
        "fields": "白名单字段：mood/symptoms/note/plans({text,done}[])",
        "deleted": "墓碑标记",
        "schemaVersion": "1",
        "revision": "乐观并发版本号",
        "updatedAt": "毫秒时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "ownerId",
              "direction": 1
            },
            {
              "name": "dateKey",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_files",
      "purpose": "报告文件登记（暂存→正式→登记完成）；文档 ID：memberId:uploadId",
      "fields": {
        "_id": "memberId:uploadId",
        "fileId": "正式文件标识",
        "familyId": "数据分区",
        "uploaderId": "服务端生成的上传成员",
        "stageFileID": "本人暂存目录 cloud fileID",
        "formalFileID": "正式副本 cloud fileID（客户端不可写目录）",
        "formalPath": "正式路径",
        "contentType": "内容嗅探结果（image/jpeg|image/png）",
        "sizeBytes": "字节数",
        "status": "registered",
        "createdAt": "毫秒时间戳",
        "registeredAt": "毫秒时间戳",
        "attachedReportIds": "事务保护的当前引用报告 ID 集合（B2b2）",
        "everAttached": "曾附着过报告（裸预览门；true 后只能走报告路由）",
        "lastDetachedAt": "引用集合清空时间（清理宽限计时起点；重复移除不重置）",
        "formalTargetPath": "复制目标路径（迟到复制孤儿回收线索）",
        "pendingCompensation": "登记侧补偿失败标记（清理按真实句柄补删）",
        "cleanedAt": "终态 deleted 时间（文件墓碑，防同 uploadId 复活）"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "uploaderId",
              "direction": 1
            },
            {
              "name": "createdAt",
              "direction": -1
            }
          ],
          "unique": false
        },
        {
          "keys": [
            {
              "field": "familyId",
              "order": "asc"
            },
            {
              "field": "_id",
              "order": "desc"
            }
          ],
          "purpose": "cleanupOrphans 全量分页遍历（墓碑墙不饥饿）"
        }
      ]
    },
    {
      "name": "mc_checkups",
      "purpose": "B2b1 shared checkups; stable ID, multiple per week",
      "fields": {
        "_id": "chk_*",
        "familyId": "partition",
        "dateKey": "YYYY-MM-DD",
        "status": "pending|completed|skipped",
        "templateKey": "unique per family",
        "source": "template|manual|manual-date",
        "deleted": "tombstone",
        "schemaVersion": "1",
        "revision": "optimistic"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "familyId",
              "direction": 1
            },
            {
              "name": "sortKey",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_bag_items",
      "purpose": "B2b1 shared hospital bag items; stable ID",
      "fields": {
        "_id": "bag_*",
        "familyId": "partition",
        "name": "1-50",
        "category": "mom|baby|documents|going|other",
        "quantity": "1-99",
        "prepared": "bool",
        "templateKey": "unique per family",
        "deleted": "tombstone",
        "schemaVersion": "1",
        "revision": "optimistic"
      },
      "indexes": [
        {
          "keys": [
            {
              "name": "familyId",
              "direction": 1
            },
            {
              "name": "_id",
              "direction": -1
            }
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "mc_reports",
      "purpose": "家庭共享报告（B2b2）：稳定报告 ID、有序附件引用、墓碑删除",
      "fields": {
        "_id": "rpt_<客户端生成稳定 ID>",
        "familyId": "数据分区（非授权依据）",
        "schemaVersion": "结构版本（当前 1）",
        "revision": "乐观并发版本号",
        "deleted": "墓碑标记（附件留档审计但不计有效引用）",
        "dateKey": "报告日期 YYYY-MM-DD",
        "reportType": "枚举（stores/report.js REPORT_TYPES）",
        "archiveStatus": "archived / unarchived",
        "note": "用户备注 ≤500 字",
        "attachments": "有序 [{fileId: mc_files 登记记录 ID}] ≤20，服务端事务校验",
        "uploaderId": "报告创建者（首次创建报告的成员；不必等于每个附件的文件上传者，附件上传者见 mc_files.uploaderId）",
        "updatedBy": "最后操作者（可与 uploader 不同）",
        "sortKey": "dateKey:id（分页稳定游标第二键）"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "familyId",
              "order": "asc"
            },
            {
              "field": "sortKey",
              "order": "desc"
            }
          ],
          "purpose": "report.list 稳定分页（含墓碑）"
        }
      ]
    },
    {
      "name": "mc_restore_batches",
      "purpose": "B3b 隔离恢复批次主文档（状态机元数据）",
      "fields": {
        "_id": "rst_<CSPRNG hex>（客户端生成的128位随机数）",
        "ownerMemberId": "批次所有者（服务端 resolveCaller 生成；全部动作仅 owner）",
        "familyId": "数据分区",
        "status": "declaring|indexing|declared|uploading|verifying|restored|abandoning|abandoned|verify-corruption",
        "packageDigest": "客户端本地验证的整包 SHA-256（不可变摘要承诺）",
        "manifestDigest": "manifest 原始字节 SHA-256",
        "claimedKind": "full|diagnostic|unknown（服务端合格判定在 declare 重组后）",
        "beginTotals": "begin 时承诺的 totals（重放须全量匹配）",
        "manifestChunkTotal": "manifest 分片数（首片 CAS 锚定后不可变）",
        "manifestParsed": "declare 重组+判定完成标记",
        "totals": "服务端判定的 {records, files, domains}（files 含 domain-json）",
        "declaredRecords": "声明记录总数",
        "declaredFiles": "声明文件总数（=服务端判定 totals.files——**含 domain-json 文件**，非仅附件）",
        "declaredRootSha": "逐声明 key 链式 SHA 根（indexDeclarePage 末页核对）",
        "indexCursor": "声明索引分页游标",
        "indexedCount": "已索引声明数",
        "indexRollingSha": "逐 key 链式滚动 SHA",
        "contentGeneration": "实际内容变更计数（upload/attach/chunk/finalize 成功 +1；幂等重放不 +1）",
        "provenGeneration": "预检完成时写入的 contentGeneration 快照",
        "proofComplete": "预检全页完成+计数/摘要全等标记",
        "contentGeneration_note": "与 provenGeneration 分离：前者仅实际变更递增，后者预检完成写入",
        "createdAt": "毫秒时间戳",
        "updatedAt": "毫秒时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "ownerMemberId",
              "order": "asc"
            },
            {
              "field": "familyId",
              "order": "asc"
            },
            {
              "field": "status",
              "order": "asc"
            }
          ],
          "purpose": "活跃批次上限查询（含 abandoning）"
        }
      ]
    },
    {
      "name": "mc_restore_declare_chunks",
      "purpose": "manifest 原始字节分片（一片一文档）",
      "fields": {
        "_id": "<batchId>:<chunkIndex>",
        "batchId": "所属批次",
        "chunkIndex": "0-based 分片序号",
        "chunkSha256": "该片原始字节 SHA-256",
        "rawB64": "分片原始字节 base64",
        "byteLength": "分片字节数"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            },
            {
              "field": "chunkIndex",
              "order": "asc"
            }
          ],
          "purpose": "按序重组读取"
        }
      ]
    },
    {
      "name": "mc_restore_declarations",
      "purpose": "声明索引（从冻结 manifest 派生的逐条/逐附件声明）",
      "fields": {
        "_id": "<batchId>:decl:<domain>:<index> 或 <batchId>:decl:file:<fileIndex>",
        "batchId": "所属批次",
        "type": "record|file",
        "domain": "记录域（record 类）",
        "index": "记录索引（record 类）",
        "fileIndex": "附件文件数组下标（file 类）",
        "id": "记录稳定 ID（record 类）",
        "revision": "记录版本（record 类）",
        "deleted": "墓碑标记（record 类）",
        "hash": "canonical SHA-256（record 类）",
        "sha256": "文件字节 SHA-256（file 类）",
        "length": "文件字节数（file 类）",
        "contentType": "文件 MIME（file 类）",
        "originalFileId": "包内原文件标识（file 类）",
        "indexedAt": "索引时间戳",
        "frozenReportAttachments": "reports 域声明的冻结附件映射 [{fileIndex, order, originalFileId}]（从 manifest.reports 冻结——uploadRecord/finalizeRecord 正文附件逐位核对凭据）"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            },
            {
              "field": "_id",
              "order": "asc"
            }
          ],
          "purpose": "批次全量分页遍历"
        }
      ]
    },
    {
      "name": "mc_restore_anchors",
      "purpose": "per-record chunkTotal 锚定 + 累计字节追踪（CAS）",
      "fields": {
        "_id": "<batchId>:anchor:<domain>:<index>",
        "batchId": "所属批次",
        "domain": "记录域",
        "recordIndex": "记录索引",
        "chunkTotal": "该记录的分片总数（首片 CAS 锚定后不可变）",
        "firstChunkSha256": "首片 SHA-256",
        "cumuBytes": "累计已上传字节数（每新 chunk 在同一事务内递增持久；重放不加）",
        "createdAt": "创建时间戳",
        "updatedAt": "最后更新时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            }
          ],
          "purpose": "abandon 组1 清理（<batchId>:anchor:*）"
        }
      ]
    },
    {
      "name": "mc_restore_records",
      "purpose": "隔离区记录（内联完整记录 或 分片元数据+chunk 引用）",
      "fields": {
        "_id": "<batchId>:<domain>:<index>",
        "batchId": "所属批次",
        "domain": "记录域",
        "index": "记录索引",
        "recordId": "记录稳定 ID",
        "revision": "记录版本",
        "deleted": "墓碑标记",
        "canonicalHash": "canonical SHA-256（与声明全等）",
        "byteLength": "原始字节长度",
        "chunkTotal": "分片数（分片记录）",
        "frozenChunkSha256": "有序逐片 SHA-256 数组 ≤103 项（verify 逐 chunk 比对用）",
        "chunkIdPrefix": "chunk 文档 ID 前缀",
        "record": "完整记录对象（仅内联 ≤48KiB 记录；分片记录不存——chunk 是唯一字节源）",
        "isChunked": "是否分片记录",
        "consumedAt": "finalize 时间戳（设置后新 chunk 被拒 record-consumed）",
        "finalizedAt": "finalize 时间戳",
        "uploadedAt": "内联上传时间戳"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            },
            {
              "field": "domain",
              "order": "asc"
            },
            {
              "field": "index",
              "order": "asc"
            }
          ],
          "purpose": "preview/verify 分页"
        }
      ]
    },
    {
      "name": "mc_restore_record_chunks",
      "purpose": "分片记录的原始字节（无限期保留——restored 批次唯一字节源）",
      "fields": {
        "_id": "<batchId>:rec:<domain>:<index>:<chunkIndex>",
        "batchId": "所属批次",
        "domain": "记录域",
        "recordIndex": "记录索引",
        "chunkIndex": "分片序号",
        "chunkSha256": "该片原始字节 SHA-256",
        "rawB64": "分片原始字节 base64",
        "byteLength": "分片字节数"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            },
            {
              "field": "domain",
              "order": "asc"
            },
            {
              "field": "recordIndex",
              "order": "asc"
            },
            {
              "field": "chunkIndex",
              "order": "asc"
            }
          ],
          "purpose": "finalize keyed get / abandon 组3 清理"
        }
      ]
    },
    {
      "name": "mc_restore_files",
      "purpose": "隔离区附件引用（引用 mc_files 正式登记）",
      "fields": {
        "_id": "<batchId>:<fileIndex>",
        "batchId": "所属批次",
        "fileIndex": "文件数组下标",
        "fileId": "mc_files 登记记录 ID（memberId:uploadId）",
        "sha256": "文件字节 SHA-256",
        "length": "文件字节数",
        "references": "从冻结声明派生的 [{reportId, order}] 引用列表"
      },
      "indexes": [
        {
          "keys": [
            {
              "field": "batchId",
              "order": "asc"
            }
          ],
          "purpose": "abandon 组5 清理"
        }
      ]
    },
    {
      "name": "mc_restore_slot_locks",
      "purpose": "begin 并发互斥：同成员活跃批次计数的槽位锁（计数+创建同一事务原子完成）",
      "fields": {
        "_id": "slotlock:<memberId>",
        "ownerMemberId": "成员（锁属主）",
        "familyId": "数据分区",
        "activeBatchIds": "最近 begin 记录的批次 ID 数组（滞后条目由下次 begin 按批次实际状态修剪，不作为状态机真源）",
        "updatedAt": "最后更新时间戳"
      },
      "indexes": []
    },
    {
      "name": "mc_restore_blocks",
      "purpose": "V20 索引块文档（finalizeDeclare 逐块持久——Merkle 叶载荷+证明；客户端直接读写全拒绝）",
      "fields": {
        "_id": "<batchId>:blk:<blockIndex>（协议 D21 精确形状——blockIndex/batchId 仅存在于 _id 键，不存独立字段；访问/清理走 _id 前缀）",
        "sha256": "位置绑定 Merkle 叶 SHA256(\"mcpkg-blk:\"‖u32be(totalBlocks)‖u32be(blockIndex)‖canonicalBytes) hex",
        "byteLength": "块 canonical 字节长（≤10,240B）",
        "entryCount": "条目数（≤48）",
        "entries": "解析后条目数组（D21 native JSON——canonical 解析形，非字符串）",
        "proof": "sibling 单串规范 base64（D20——按父层升序拼接 ⌈log2(totalBlocks)⌉×32B；T=1 空串）"
      },
      "indexes": []
    }
  ]
}
